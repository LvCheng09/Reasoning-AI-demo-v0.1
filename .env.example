# The semantic frontend uses only this model. Do not put a real key in this file.
export LLM_BASE_URL="https://api.siliconflow.cn/v1"
export LLM_MODEL="Qwen/Qwen3-8B"
export LLM_API_KEY="replace-with-your-api-key"

# The backend uses a local embedding model for Rule / Knowledge retrieval.
# On first run, Hugging Face downloads it. Set this to a local snapshot path to
# work offline, then uncomment the next line.
export MAIN_PART_EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"
# export MAIN_PART_EMBEDDING_LOCAL_FILES_ONLY="true"

# Kept explicit so the demo uses the semantic frontend boundary.
export MAIN_PART_FRONTEND_IMPLEMENTATION="semantic_v1"

# Transport limits only; these never change the selected model.
export LLM_READ_TIMEOUT_SECONDS="180"
export LLM_MAX_OUTPUT_TOKENS="4096"
export LLM_MAX_RETRIES="1"

# Default: every launcher receives fresh writable DBs in runtime/inference_*.
# export MAIN_PART_RUNTIME_DIR="/path/to/runtime-workspaces"
# MAIN_PART_DB_DIR is only for existing, explicitly managed runtime DBs.
# Never point it at data/demo/db, the immutable released seed databases.
